# Copier en .env.local et compléter. .env.local n'est pas versionné.

DATABASE_URL="postgresql://user:motdepasse@host:5432/gosejour?sslmode=verify-full"

# Domaine public du site. Sert à rendre absolue l'URL de l'image de partage
# (src/app/opengraph-image.png) ; sans elle, les réseaux sociaux l'ignorent.
SITE_URL="https://gosejour.fr"

ADMIN_SESSION_SECRET="valeur-aleatoire-de-32-octets-minimum"
ADMIN_EMAIL="admin@gosejour.fr"
ADMIN_PASSWORD="a-changer"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="gosejour"

# Boîte e-mail de contact. Préparé pour une future intégration SMTP côté app.
# IMAP sert au client mail, pas au site lui-même.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@gosejour.fr"
SMTP_PASSWORD=""
SMTP_FROM="GoSéjour <contact@gosejour.fr>"
BOOKING_NOTIFICATION_EMAIL="contact@gosejour.fr"
IMAP_HOST="imap.hostinger.com"
